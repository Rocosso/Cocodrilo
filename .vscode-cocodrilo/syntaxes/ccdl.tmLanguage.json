{
  "name": "Cocodrilo",
  "scopeName": "source.cocodrilo",
  "fileTypes": ["ccdl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#labels" },
    { "include": "#types" },
    { "include": "#registers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#suffixes" },
    { "include": "#instructions" },
    { "include": "#directives" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.cocodrilo"
        },
        {
          "match": "#.*$",
          "name": "comment.line.hash.cocodrilo"
        }
      ]
    },
    "labels": {
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "entity.name.function.cocodrilo"
    },
    "types": {
      "match": "\\b(octeto|palabra|doble_palabra|cuadruple_palabra)\\b",
      "name": "storage.type.cocodrilo"
    },
    "registers": {
      "match": "\\b([A-H]|SP|IP)\\b",
      "name": "variable.language.register.cocodrilo"
    },
    "constants": {
      "match": "\\b(const|fn|asm)\\b",
      "name": "keyword.control.cocodrilo"
    },
    "keywords": {
      "match": "\\b(si|no)\\b",
      "name": "keyword.operator.word.cocodrilo"
    },
    "suffixes": {
      "match": "\\.(o|p|dp|cp)\\b",
      "name": "storage.modifier.suffix.cocodrilo"
    },
    "instructions": {
      "patterns": [
        {
          "comment": "Movimiento y memoria",
          "match": "\\b(mover|leer|escribir)\\b",
          "name": "support.function.memory.cocodrilo"
        },
        {
          "comment": "Aritmeticas",
          "match": "\\b(sumar|restar)\\b",
          "name": "support.function.arithmetic.cocodrilo"
        },
        {
          "comment": "Logicas bitwise",
          "match": "\\b(y|o|o_exclusivo|no)\\b",
          "name": "support.function.logical.cocodrilo"
        },
        {
          "comment": "Comparacion",
          "match": "\\b(comparar)\\b",
          "name": "support.function.compare.cocodrilo"
        },
        {
          "comment": "Saltos condicionales (deben ir antes que saltar solo)",
          "match": "\\b(saltar_si_(igual|no_igual|mayor|menor|mayor_igual|menor_igual))\\b",
          "name": "support.function.conditional.cocodrilo"
        },
        {
          "comment": "Salto incondicional",
          "match": "\\b(saltar)\\b",
          "name": "support.function.jump.cocodrilo"
        },
        {
          "comment": "Pila",
          "match": "\\b(apilar|desapilar)\\b",
          "name": "support.function.stack.cocodrilo"
        },
        {
          "comment": "Llamadas",
          "match": "\\b(llamar|retornar)\\b",
          "name": "support.function.call.cocodrilo"
        },
        {
          "comment": "Sistema",
          "match": "\\b(detener|retraso_ciclos)\\b",
          "name": "support.function.system.cocodrilo"
        }
      ]
    },
    "directives": {
      "match": "\\b(org)\\b",
      "name": "keyword.control.directive.cocodrilo"
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.cocodrilo"
    },
    "punctuation": {
      "match": "[,\\[\\]+\\-\\*]",
      "name": "punctuation.operator.cocodrilo"
    }
  }
}
