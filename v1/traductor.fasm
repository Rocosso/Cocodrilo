; cocodrilo V1 - Traductor bootstrap en FASM
; Compila: fasm traductor.fasm traductor
; Uso: ./traductor entrada.ccdl salida.bin
;
; Traduce un subconjunto minimo de Cocodrilo a codigo maquina x86.
; Soporta: mover, sumar, restar, cmp, saltos, const, etiquetas

format ELF executable 3
entry _start

SYS_EXIT  = 1
SYS_READ  = 3
SYS_WRITE = 4
SYS_OPEN  = 5
SYS_CLOSE = 6

O_RDONLY   = 0
O_WRONLY   = 1
O_CREAT    = 0100o
O_TRUNC    = 01000o
STDERR     = 2

BUFFER_SZ  = 0x10000
MAX_LABS   = 256
LAB_SZ     = 64
MAX_TOKS   = 16

; Registros: A=eax(0), C=ecx(1), D=edx(2), B=ebx(3)
REG_A = 0
REG_C = 1
REG_D = 2
REG_B = 3

segment readable writeable

src_buf  rb BUFFER_SZ
src_size rd 1
src_pos  rd 1

out_buf  rb BUFFER_SZ
out_pos  rd 1
cur_ip   rd 1

lab_name rb MAX_LABS * LAB_SZ
lab_addr rd MAX_LABS
lab_cnt  rd 1

cst_name rb MAX_LABS * LAB_SZ
cst_val  rd MAX_LABS
cst_cnt  rd 1

str_data    rb BUFFER_SZ         ; datos de strings concatenados
str_data_sz rd 1                 ; bytes usados en str_data
str_name    rb MAX_LABS * LAB_SZ ; nombre del string
str_addr    rd MAX_LABS          ; offset dentro de str_data
str_len     rd MAX_LABS          ; longitud de cada string
str_cnt     rd 1                 ; cantidad de strings

patch_ip    rd MAX_LABS          ; cur_ip donde se emitio la referencia
patch_str   rd MAX_LABS          ; indice del string referenciado
patch_cnt   rd 1

line_buf rb 256
tokens   rd MAX_TOKS
tok_cnt  rd 1

addr_buf rb 64         ; buffer para parsear numeros/nombres
inp_fname rb 256
out_fname rb 256

msg_usage    db 'Uso: traductor <entrada.cdr> <salida.bin>', 10
msg_usage_sz = $ - msg_usage
msg_noent    db 'Error: no se puede abrir ', 0
msg_readerr  db 'Error: no se puede leer ', 0
msg_wrterr   db 'Error: no se puede escribir ', 10
msg_wrterr_sz = $ - msg_wrterr
msg_labfull  db 'Error: tabla de etiquetas llena', 10
msg_labfull_sz = $ - msg_labfull
msg_synerr   db 'Error de sintaxis', 10
msg_synerr_sz = $ - msg_synerr
msg_name_long db 'Error: nombre demasiado largo', 10
msg_name_long_sz = $ - msg_name_long
msg_tok_full  db 'Error: demasiados tokens en linea', 10
msg_tok_full_sz = $ - msg_tok_full
msg_buf_full  db 'Error: buffer de salida lleno', 10
msg_buf_full_sz = $ - msg_buf_full
msg_str_full  db 'Error: tabla de strings llena', 10
msg_str_full_sz = $ - msg_str_full
msg_patch_full db 'Error: demasiadas referencias a strings', 10
msg_patch_full_sz = $ - msg_patch_full
msg_str_not   db 'Error: string no encontrado', 10
msg_str_not_sz = $ - msg_str_not

segment readable executable

_start:
    pop ecx
    cmp ecx, 3
    jb usage

    pop eax
    pop ebx                     ; argv[1] = entrada
    pop edx                     ; argv[2] = salida

    mov esi, ebx
    mov edi, inp_fname
    mov ecx, 256
    call str_cpy_max
    jc usage

    mov esi, edx
    mov edi, out_fname
    mov ecx, 256
    call str_cpy_max
    jc usage

    xor eax, eax
    mov [src_pos], eax
    mov [out_pos], eax
    mov [cur_ip], eax
    mov [lab_cnt], eax
    mov [cst_cnt], eax
    mov [str_data_sz], eax
    mov [str_cnt], eax
    mov [patch_cnt], eax

    ; Abrir entrada
    mov eax, SYS_OPEN
    mov ebx, inp_fname
    mov ecx, O_RDONLY
    int 0x80
    test eax, eax
    js open_err
    mov ebx, eax

    ; Leer entrada
    mov eax, SYS_READ
    mov ecx, src_buf
    mov edx, BUFFER_SZ
    int 0x80
    test eax, eax
    js read_err
    mov [src_size], eax

    mov eax, SYS_CLOSE
    int 0x80

    ; PASE 1: recolectar etiquetas y constantes
    call pase1

    ; Reiniciar posicion de lectura
    mov [src_pos], 0

    ; PASE 2: generar codigo maquina
    call pase2

    ; Resolver referencias a strings y emitir datos
    call parchear_strings

    ; Crear salida
    mov eax, SYS_OPEN
    mov ebx, out_fname
    mov ecx, O_WRONLY + O_CREAT + O_TRUNC
    mov edx, 0755o
    int 0x80
    test eax, eax
    js write_err
    mov ebx, eax

    mov eax, SYS_WRITE
    mov ecx, out_buf
    mov edx, [out_pos]
    int 0x80

    mov eax, SYS_CLOSE
    int 0x80

    xor ebx, ebx
    mov eax, SYS_EXIT
    int 0x80

; ---- str_cpy_max: copia esi -> edi, max ecx-1 bytes, NUL terminado ----
; CF=1 si se truncó (nombre demasiado largo)
str_cpy_max:
    push eax ecx edi
    test ecx, ecx
    jz .trunc
    dec ecx
.loop:
    test ecx, ecx
    jz .trunc
    lodsb
    stosb
    test al, al
    jz .ok
    dec ecx
    jmp .loop
.trunc:
    mov byte [edi], 0
    stc
    pop edi ecx eax
    ret
.ok:
    clc
    pop edi ecx eax
    ret

; ---- leer_linea: lee linea del src_buf a line_buf ----
; devuelve: ecx = longitud, ZF=1 si EOF
leer_linea:
    push eax esi edi
    mov edi, line_buf
    xor ecx, ecx

.loop:
    mov eax, [src_pos]
    cmp eax, [src_size]
    jae .eof

    mov esi, src_buf
    add esi, eax
    lodsb
    inc [src_pos]

    cmp al, 10
    je .fin
    cmp al, 13
    je .loop

    stosb
    inc ecx
    cmp ecx, 254
    jb .loop

.fin:
    xor eax, eax
    stosb
    test ecx, ecx
    jmp .ret

.eof:
    xor eax, eax
    stosb
    xor ecx, ecx
    test ecx, ecx

.ret:
    pop edi esi eax
    ret

; ---- tokenizar: separa line_buf en tokens ----
; devuelve: tok_cnt
tokenizar:
    push eax ecx edi esi
    mov edi, tokens
    xor ecx, ecx
    mov esi, line_buf

.saltar:
    lodsb
    cmp al, ' '
    je .saltar
    cmp al, 9
    je .saltar
    cmp al, ','
    je .saltar
    cmp al, 0
    je .fin

    dec esi
    cmp ecx, MAX_TOKS
    jae tok_err
    mov [edi], esi
    add edi, 4
    inc ecx

.buscar:
    lodsb
    cmp al, ' '
    je .fin_pal
    cmp al, 9
    je .fin_pal
    cmp al, ','
    je .fin_pal
    cmp al, 0
    je .fin
    cmp al, 10
    je .fin
    cmp al, 13
    je .fin
    jmp .buscar

.fin_pal:
    mov byte [esi-1], 0
    jmp .saltar

.fin:
    mov [tok_cnt], ecx
    pop edi esi ecx eax
    ret

; ---- es_num: comprueba si string es numero ----
; esi = string, devuelve: ZF=1 si es numero, ZF=0 si no
es_num:
    push eax esi
    lodsb
    cmp al, '0'
    jb .no
    cmp al, '9'
    ja .no
.mas:
    lodsb
    test al, al
    jz .si
    cmp al, '0'
    jb .no
    cmp al, '9'
    jbe .mas
.no:
    mov al, 1       ; al=1, ZF=0
    test al, al
    jmp .ret
.si:
    xor al, al      ; al=0, ZF=1
    test al, al
.ret:
    pop esi eax
    ret

; ---- parse_num: convierte string en esi a entero en eax ----
parse_num:
    push ebx ecx edx esi
    xor edx, edx
.loop:
    xor eax, eax
    lodsb
    test al, al
    jz .fin
    sub al, '0'
    imul edx, 10
    add edx, eax
    jmp .loop
.fin:
    mov eax, edx
    pop esi edx ecx ebx
    ret

; ---- buscar_lab: busca etiqueta @name en lab_name ----
; esi = nombre (sin @), devuelve: edi=offset, CF=0 si encontrada
buscar_lab:
    push eax ecx esi
    mov ecx, [lab_cnt]
    test ecx, ecx
    jz .no

    mov edi, lab_name
.loop:
    push esi edi ecx
.cmp:
    mov al, [esi]
    mov ah, [edi]
    cmp al, ah
    jne .sig
    test al, al
    jz .encontrado
    inc esi
    inc edi
    jmp .cmp
.sig:
    pop ecx edi esi
    add edi, LAB_SZ
    loop .loop
    jmp .no

.encontrado:
    pop ecx edi esi
    pop ecx esi eax
    ; Calcular offset: edi - lab_name / LAB_SZ
    sub edi, lab_name
    xor edx, edx
    mov eax, edi
    mov ecx, LAB_SZ
    div ecx
    mov edi, eax           ; indice
    mov eax, [lab_addr + edi*4]  ; offset
    clc
    ret

.no:
    pop ecx esi eax
    stc
    ret

; ---- buscar_cst: busca constante name en cst_name ----
; esi = nombre, devuelve: eax=valor, CF=0 si encontrada
buscar_cst:
    push ecx esi edi
    mov ecx, [cst_cnt]
    test ecx, ecx
    jz .no

    mov edi, cst_name
.loop:
    push esi edi ecx
.cmp:
    mov al, [esi]
    mov ah, [edi]
    cmp al, ah
    jne .sig
    test al, al
    jz .encontrado
    inc esi
    inc edi
    jmp .cmp
.sig:
    pop ecx edi esi
    add edi, LAB_SZ
    loop .loop
    jmp .no

.encontrado:
    pop ecx edi esi
    pop ecx esi eax
    sub edi, cst_name
    xor edx, edx
    mov eax, edi
    mov ecx, LAB_SZ
    div ecx
    mov eax, [cst_val + eax*4]
    clc
    ret

.no:
    pop ecx esi eax
    stc
    ret

; ---- resolver_valor: convierte string a valor numerico ----
; esi = string, devuelve: eax=valor, CF=0 si ok
resolver_valor:
    push esi
    call es_num
    pop esi
    jz .numero

    ; Intentar como constante
    push esi
    call buscar_cst
    pop esi
    jnc .ret

    stc
    ret

.numero:
    call parse_num
    clc
.ret:
    ret

; ---- emitir_byte: escribe un byte al output ----
emitir_byte:
    push ebx
    mov ebx, [out_pos]
    cmp ebx, BUFFER_SZ
    jae buf_err
    mov [out_buf + ebx], al
    inc [out_pos]
    inc [cur_ip]
    pop ebx
    ret

; ---- emitir_dword: escribe dword little-endian ----
emitir_dword:
    push eax
    call emitir_byte
    shr eax, 8
    call emitir_byte
    shr eax, 8
    call emitir_byte
    shr eax, 8
    call emitir_byte
    pop eax
    ret

lab_no_encontrada:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_synerr
    mov edx, msg_synerr_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

; ---- registrar_reg: devuelve en ebx el codigo del registro ----
; esi = "A"|"B"|"C"|"D", devuelve ebx = 0|3|1|2
registrar_reg:
    push eax
    lodsb
    xor ebx, ebx
    cmp al, 'A'
    je .fin
    mov ebx, 3          ; B = ebx
    cmp al, 'B'
    je .fin
    mov ebx, 1          ; C = ecx
    cmp al, 'C'
    je .fin
    mov ebx, 2          ; D = edx
    cmp al, 'D'
    je .fin
    mov ebx, -1
.fin:
    pop eax
    ret

; ---- PASE 1: recolectar etiquetas (@) y constantes (const) ----
pase1:
    push eax ebx ecx edx esi edi

.loop:
    mov eax, [src_pos]
    cmp eax, [src_size]
    jae .fin

    call leer_linea

    call tokenizar
    cmp [tok_cnt], 0
    je .loop

    ; Primer token
    mov esi, tokens
    lodsd
    mov esi, eax
    lodsb

    cmp al, '/'
    je .loop

    cmp al, '@'
    je .loop          ; etiquetas se registran en pase2

    cmp al, 'c'
    je .check_const

    jmp .loop

.check_const:
    mov esi, tokens
    lodsd
    mov esi, eax
    ; Segunda letra
    cmp byte [esi+1], 'o'
    je .check_const_name
    cmp byte [esi+1], 'a'
    je .check_cadena
    jmp .loop

.check_const_name:
    ; "const": c,o,n,s,t
    cmp byte [esi+2], 'n'
    jne .loop
    cmp byte [esi+3], 's'
    jne .loop
    cmp byte [esi+4], 't'
    jne .loop
    cmp byte [esi+5], 0
    jne .loop
    ; Es "const"
    call procesar_const
    jmp .loop

.check_cadena:
    ; "cadena": c,a,d,e,n,a
    cmp byte [esi+2], 'd'
    jne .loop
    cmp byte [esi+3], 'e'
    jne .loop
    cmp byte [esi+4], 'n'
    jne .loop
    cmp byte [esi+5], 'a'
    jne .loop
    cmp byte [esi+6], 0
    jne .loop
    ; Es "cadena"
    call procesar_cadena
    jmp .loop

.fin:
    pop edi esi edx ecx ebx eax
    ret

; ---- procesar_const: const NAME = VALOR ----
procesar_const:
    push eax ebx ecx edx esi edi

    ; Segundo token = nombre
    mov esi, tokens + 4
    lodsd
    mov esi, eax

    mov edi, cst_name
    mov eax, [cst_cnt]
    imul eax, LAB_SZ
    add edi, eax
    mov ecx, LAB_SZ
    call str_cpy_max
    jc name_err

    ; Tercer token = "=" (opcional, lo saltamos)
    ; Cuarto token = valor
    mov esi, tokens + 8
    lodsd
    mov esi, eax

    ; Verificar si es '='
    lodsb
    cmp al, '='
    je .saltar_igual

    ; No era '=', volver a empezar
    dec esi
    call resolver_valor
    jmp .guardar

.saltar_igual:
    mov esi, tokens + 12
    lodsd
    mov esi, eax
    call resolver_valor

.guardar:
    mov ebx, [cst_cnt]
    mov [cst_val + ebx*4], eax
    inc [cst_cnt]

    pop edi esi edx ecx ebx eax
    ret

; ---- procesar_cadena: cadena NOMBRE = "contenido" ----
procesar_cadena:
    push eax ebx ecx esi edi

    ; Verificar que hay al menos 3 tokens (cadena NOMBRE "...")
    cmp [tok_cnt], 3
    jb .error

    ; Token[1] = nombre
    mov esi, [tokens + 4]
    mov edi, str_name
    mov eax, [str_cnt]
    cmp eax, MAX_LABS
    jae str_full
    imul eax, LAB_SZ
    add edi, eax
    mov ecx, LAB_SZ
    call str_cpy_max
    jc name_err

    ; Token[2] = "=" o contenido
    mov esi, [tokens + 8]
    lodsb
    cmp al, '='
    je .con_valor

    ; Sin "=", token[2] es el contenido directamente
    dec esi
    call .copiar_contenido
    jmp .fin

.con_valor:
    ; Con "=", token[3] es el contenido
    cmp [tok_cnt], 4
    jb .error
    mov esi, [tokens + 12]
    call .copiar_contenido

.fin:
    inc [str_cnt]
    pop edi esi ecx ebx eax
    ret

.error:
    pop edi esi ecx ebx eax
    jmp syn_err

; ---- copiar_contenido: copia string entre comillas a str_data ----
; esi = puntero al primer caracter (despues de la comilla de apertura)
.copiar_contenido:
    push eax ecx esi edi
    ; Saltar comilla de apertura si existe
    cmp byte [esi], '"'
    jne .sin_comillas
    inc esi
.sin_comillas:
    ; Calcular destino en str_data
    mov edi, str_data
    add edi, [str_data_sz]
    xor ecx, ecx            ; longitud = 0

.copiar_loop:
    lodsb
    cmp al, '"'
    je .fin_copia
    cmp al, 0
    je .fin_copia
    cmp al, 10              ; newline
    je .escape_n
    cmp al, '\'
    jne .guardar_byte
    ; Secuencia de escape
    lodsb
    cmp al, 'n'
    jne .guardar_byte
    mov al, 10              ; \n -> newline
.guardar_byte:
    stosb
    inc ecx
    jmp .copiar_loop

.escape_n:
    mov al, 10
    jmp .guardar_byte

.fin_copia:
    ; Terminar con NUL
    xor al, al
    stosb
    ; Registrar longitud
    mov eax, [str_cnt]
    mov [str_len + eax*4], ecx
    ; Avanzar str_data_sz (longitud + 1 para NUL)
    inc ecx
    add [str_data_sz], ecx
    pop edi esi ecx eax
    ret

; ---- PASE 2: generar codigo maquina ----
pase2:
    push eax ebx ecx edx esi edi

.loop:
    mov eax, [src_pos]
    cmp eax, [src_size]
    jae .fin

    call leer_linea

    call tokenizar
    cmp [tok_cnt], 0
    je .loop

    ; Primer token = instruccion
    mov esi, tokens
    lodsd
    mov esi, eax
    lodsb

    cmp al, '/'
    je .loop
    cmp al, '@'
    je .cmd_label
    cmp al, 'c'
    je .saltar_const

    ; Decodificar instruccion por primera letra
    cmp al, 'm'
    je .cmd_mover
    cmp al, 's'
    je .saltar_sum     ; saltar o sumar
    cmp al, 'r'
    je .cmd_restar
    cmp al, 'd'
    je .cmd_detener
    cmp al, 'l'
    je .check_llamar_leer
    cmp al, 'e'
    je .do_escribir

    jmp .error

.check_llamar_leer:
    ; Distinguir "llamar" de "leer"
    push eax
    mov esi, [tokens]
    mov al, [esi+1]        ; segunda letra
    cmp al, 'l'            ; **l**lamar
    je .do_llamar
    cmp al, 'e'            ; **e**er (leer)
    je .do_leer
    pop eax
    jmp .error

.do_llamar:
    pop eax

.saltar_sum:
    ; Distinguir "saltar", "sumar", "salir"
    push eax
    mov esi, [tokens]
    mov al, [esi+1]        ; segunda letra
    cmp al, 'u'            ; s**u**mar
    je .do_sumar
    cmp al, 'a'            ; s**a**ltar o s**a**lir
    je .check_saltar_salir
    pop eax
    jmp .error

.check_saltar_salir:
    mov al, [esi+3]        ; cuarta letra
    cmp al, 't'            ; sal**t**ar
    je .do_saltar
    cmp al, 'i'            ; sal**i**r
    je .do_salir
    pop eax
    jmp .error

.do_salir:
    pop eax
    call instr_salir
    jmp .loop

.do_sumar:
    pop eax
    call instr_sumar
    jmp .loop

.do_saltar:
    pop eax
    call instr_salto
    jmp .loop

.saltar_const:
    ; "const", "cadena" o "comparar"
    push eax
    mov esi, [tokens]
    mov al, [esi+1]        ; segunda letra
    cmp al, 'o'            ; "const" o "comparar"
    je .check_co
    cmp al, 'a'            ; "cadena"
    je .check_cadena
    pop eax
    jmp .error

.check_co:
    ; Tercera letra: 'n' = const, 'm' = comparar
    mov al, [esi+2]
    cmp al, 'n'            ; co**n**st
    je .skip
    cmp al, 'm'            ; co**m**parar
    je .do_comparar
    pop eax
    jmp .error

.check_cadena:
    ; Verificar "cadena" completo: c,a,d,e,n,a
    cmp byte [esi+2], 'd'
    jne .error
    cmp byte [esi+3], 'e'
    jne .error
    cmp byte [esi+4], 'n'
    jne .error
    cmp byte [esi+5], 'a'
    jne .error
    cmp byte [esi+6], 0
    jne .error
    pop eax
    jmp .skip              ; cadena ya se proceso en pase1

.do_comparar:
    pop eax
    call instr_comparar
    jmp .loop

.skip:
    pop eax
    jmp .loop

.cmd_label:
    mov esi, [tokens]
    inc esi
    mov edi, lab_name
    mov eax, [lab_cnt]
    cmp eax, MAX_LABS
    jae lab_full
    imul eax, LAB_SZ
    add edi, eax
    mov ecx, LAB_SZ
    call str_cpy_max
    jc name_err
    mov eax, [lab_cnt]
    mov ebx, [cur_ip]
    mov [lab_addr + eax*4], ebx
    inc [lab_cnt]
    jmp .loop

.cmd_mover:
    call instr_mover
    jmp .loop

.cmd_sumar:
    call instr_sumar
    jmp .loop

.cmd_restar:
    call instr_restar
    jmp .loop

.cmd_detener:
    mov al, 0xF4       ; hlt
    call emitir_byte
    jmp .loop

.do_llamar:
    call instr_llamar
    jmp .loop

.cmd_saltar:
    ; "saltar", "saltar_si_igual", "saltar_si_no_igual"
    call instr_salto
    jmp .loop

.do_escribir:
    call instr_escribir
    jmp .loop

.do_leer:
    call instr_leer
    jmp .loop

.do_salir:
    call instr_salir
    jmp .loop

.error:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_synerr
    mov edx, msg_synerr_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

.fin:
    pop edi esi edx ecx ebx eax
    ret

; ---- instr_mover: mover dst, src ----
; Variantes: reg,reg | reg,imm | reg,[reg] | [reg],reg
instr_mover:
    push eax ebx ecx edx esi edi

    ; Segundo token = destino
    mov esi, [tokens + 4]
    lodsb
    cmp al, '['
    je .mem_dest
    dec esi
    call registrar_reg
    cmp ebx, -1
    je .error
    mov edx, ebx               ; edx = dst reg

    ; Tercer token = origen
    mov esi, [tokens + 8]
    lodsb
    cmp al, '['
    je .mem_src
    dec esi

    call es_num
    jz .imm
    push edx
    call buscar_cst
    pop edx
    jnc .imm

    ; mover reg, reg -> 89 ModRM mod=11, reg=src, rm=dst
    push edx
    call registrar_reg
    pop edx
    cmp ebx, -1
    je .error

    mov al, 0x89
    call emitir_byte
    mov al, bl
    shl al, 3
    or al, 0xC0
    or al, dl
    call emitir_byte
    jmp .fin_ok

.imm:
    ; mover reg, imm32 -> B8+rd imm32
    call resolver_valor ; eax = value
    mov ecx, eax        ; ecx = value
    mov al, 0xB8
    add al, dl          ; al = 0xB8 | dst
    call emitir_byte
    mov eax, ecx
    call emitir_dword
    jmp .fin_ok

.mem_src:
    ; mover reg, [reg] -> 8B ModRM mod=00, reg=dst, rm=src
    mov esi, [tokens + 8]
    inc esi              ; saltar [
    push edx             ; save dst
    call registrar_reg
    pop edx
    cmp ebx, -1
    je .error

    mov al, 0x8B
    call emitir_byte
    mov al, dl           ; dst in bits 5:3
    shl al, 3
    or al, bl            ; src in bits 2:0
    call emitir_byte
    jmp .fin_ok

.mem_dest:
    ; mover [reg], reg -> 89 ModRM mod=00, reg=src, rm=dst
    inc esi              ; saltar [
    push edx
    call registrar_reg
    pop edx
    cmp ebx, -1
    je .error
    mov edx, ebx         ; edx = mem base reg

    ; Tercer token = src register
    mov esi, [tokens + 8]
    call registrar_reg
    cmp ebx, -1
    je .error

    mov al, 0x89
    call emitir_byte
    mov al, bl           ; src in bits 5:3
    shl al, 3
    or al, dl            ; dst mem in bits 2:0
    call emitir_byte

.fin_ok:
    pop edi esi edx ecx ebx eax
    ret

.error:
    pop edi esi edx ecx ebx eax
    jmp syn_err

; ---- instr_sumar: sumar dst, src ----
; Opcodes: 01 (reg,reg), 05 (eax,imm), 81/0 (reg,imm)
instr_sumar:
    push eax ebx ecx edx esi edi
    mov esi, [tokens + 4]
    call registrar_reg
    cmp ebx, -1
    je .error
    mov edx, ebx               ; edx = dst reg

    mov esi, [tokens + 8]
    call es_num
    jz .inm
    push edx
    call buscar_cst
    pop edx
    jnc .inm
    push edx
    call registrar_reg
    pop edx
    cmp ebx, -1
    je .error

    ; sumar reg, reg -> 01 /r
    mov al, 0x01
    call emitir_byte
    mov al, bl
    shl al, 3
    or al, 0xC0
    or al, dl
    call emitir_byte
    jmp .fin

.inm:
    call resolver_valor   ; eax = value
    mov ecx, eax          ; ecx = imm value
    cmp dl, REG_A
    je .eax_imm
    ; 81 /0 id: add r/m32, imm32
    mov al, 0x81
    call emitir_byte
    mov al, 0xC0
    or al, dl             ; mod=11, reg=000(add), rm=reg
    call emitir_byte
    mov eax, ecx
    call emitir_dword
    jmp .fin

.eax_imm:
    mov al, 0x05
    call emitir_byte
    mov eax, ecx
    call emitir_dword

.fin:
    pop edi esi edx ecx ebx eax
    ret

.error:
    pop edi esi edx ecx ebx eax
    jmp syn_err

; ---- instr_restar: restar dst, src ----
; Opcodes: 29 (reg,reg), 2D (eax,imm), 81/5 (reg,imm)
instr_restar:
    push eax ebx ecx edx esi edi
    mov esi, [tokens + 4]
    call registrar_reg
    cmp ebx, -1
    je .error
    mov edx, ebx               ; edx = dst reg

    mov esi, [tokens + 8]
    call es_num
    jz .inm
    push edx
    call buscar_cst
    pop edx
    jnc .inm
    push edx
    call registrar_reg
    pop edx
    cmp ebx, -1
    je .error

    ; reg, reg -> 29 /r
    mov al, 0x29
    call emitir_byte
    mov al, bl
    shl al, 3
    or al, 0xC0
    or al, dl
    call emitir_byte
    jmp .fin

.inm:
    call resolver_valor   ; eax = value
    mov ecx, eax          ; ecx = imm value
    cmp dl, REG_A
    je .eax_imm
    mov al, 0x81
    call emitir_byte
    mov al, 0xE8          ; 0xC0 | (5 << 3) = 0xE8, reg field=5 for sub
    or al, dl
    call emitir_byte
    mov eax, ecx
    call emitir_dword
    jmp .fin

.eax_imm:
    mov al, 0x2D
    call emitir_byte
    mov eax, ecx
    call emitir_dword

.fin:
    pop edi esi edx ecx ebx eax
    ret

.error:
    pop edi esi edx ecx ebx eax
    jmp syn_err

; ---- instr_comparar: comparar dst, src ----
; Opcodes: 39 (reg,reg), 3D (eax,imm), 81/7 (reg,imm)
instr_comparar:
    push eax ebx ecx edx esi edi
    mov esi, [tokens + 4]
    call registrar_reg
    cmp ebx, -1
    je .error
    mov edx, ebx

    mov esi, [tokens + 8]
    call es_num
    jz .inm
    push edx
    call buscar_cst
    pop edx
    jnc .inm
    push edx
    call registrar_reg
    pop edx
    cmp ebx, -1
    je .error

    ; reg, reg -> 39 /r
    mov al, 0x39
    call emitir_byte
    mov al, bl
    shl al, 3
    or al, 0xC0
    or al, dl
    call emitir_byte
    jmp .fin

.inm:
    call resolver_valor
    mov ecx, eax
    cmp dl, REG_A
    je .eax_imm
    mov al, 0x81
    call emitir_byte
    mov al, 0xF8          ; 0xC0 | (7 << 3) = 0xF8
    or al, dl
    call emitir_byte
    mov eax, ecx
    call emitir_dword
    jmp .fin

.eax_imm:
    mov al, 0x3D
    call emitir_byte
    mov eax, ecx
    call emitir_dword

.fin:
    pop edi esi edx ecx ebx eax
    ret

.error:
    pop edi esi edx ecx ebx eax
    jmp syn_err

; ---- instr_salto: saltar, saltar_si_igual, etc ----
instr_salto:
    push eax ebx ecx edx esi edi

    ; Comparar "saltar" vs "saltar_si_igual" vs "saltar_si_no_igual"
    mov esi, tokens
    lodsd
    mov esi, eax
    cmp byte [esi+6], 0
    jne .no_saltar
    cmp byte [esi+5], 'r'
    jne .error
    jmp .incondicional

.no_saltar:
    cmp byte [esi+6], '_'       ; todas las variantes largas tienen _ en pos 6
    jne .error
    cmp byte [esi+15], 0        ; saltar_si_igual = 15 chars (0-14)
    jne .largo18
    jmp .si_igual

.largo18:
    cmp byte [esi+18], 0        ; saltar_si_no_igual = 18 chars (0-17)
    jne .error
    jmp .si_no_igual

.incondicional:
    mov al, 0xEB
    jmp .emitir

.si_igual:
    mov al, 0x74
    jmp .emitir

.si_no_igual:
    mov al, 0x75

.emitir:
    call emitir_byte        ; opcode (EB/74/75)
    mov edx, [cur_ip]       ; posicion del byte rel8
    inc edx                 ; +1 (sigue inmediatamente despues del opcode)

    mov esi, tokens + 4
    lodsd
    mov esi, eax
    cmp byte [esi], '@'
    jne .error
    inc esi                 ; saltar @
    push edx                ; salvar cur_ip+1 (buscar_lab destruye edx)
    call buscar_lab
    pop edx                 ; restaurar cur_ip+1
    jc lab_no_encontrada

    sub eax, edx            ; offset = label_addr - current_pos
    call emitir_byte

    pop edi esi edx ecx ebx eax
    ret

.error:
    pop edi esi edx ecx ebx eax
    jmp syn_err

; ---- instr_llamar: llamar @funcion ----
instr_llamar:
    push eax ebx ecx edx esi edi
    mov al, 0xE8           ; call rel32
    call emitir_byte

    mov edx, [cur_ip]
    add edx, 4             ; posicion despues del rel32 (call = 1 opcode + 4 offset)

    mov esi, tokens + 4
    lodsd
    mov esi, eax
    cmp byte [esi], '@'
    jne .error
    inc esi
    push edx                ; salvar cur_ip (buscar_lab destruye edx)
    call buscar_lab
    pop edx                 ; restaurar cur_ip
    jc lab_no_encontrada

    ; rel32 = label_addr - current_pos
    sub eax, edx
    call emitir_dword

    pop edi esi edx ecx ebx eax
    ret

.error:
    pop edi esi edx ecx ebx eax
    jmp syn_err

; ---- instr_salir: salir A (exit with code in register A) ----
; Syntax: salir A
; Emite: mov eax, 1 / mov ebx, <reg> / int 0x80
instr_salir:
    push eax ebx

    ; Verificar token[1] = registro
    mov esi, [tokens + 4]
    call parse_reg         ; eax = 0..3 (al, cl, dl, bl)
    jc .error

    ; mov eax, 1 (sys_exit)
    mov al, 0xB8
    call emitir_byte
    mov eax, 1
    call emitir_dword

    ; mov ebx, <reg>
    mov al, 0x89
    call emitir_byte
    ; ModRM: mod=11, reg=<src>, rm=011(ebx)
    mov al, 0xC3           ; base = 11_000_011
    or al, [reg_enc + eax]  ; combina reg en bits 3-5
    call emitir_byte

    ; int 0x80
    mov al, 0xCD
    call emitir_byte
    mov al, 0x80
    call emitir_byte

    pop ebx eax
    ret

.error:
    pop ebx eax
    jmp syn_err

; ---- instr_leer: leer A, N (read stdin into variable) ----
; Syntax: leer A, N
; Lee de stdin y guarda en variable N (buffer en data section)
; Emite: syscall read(0, addr, len)
instr_leer:
    push eax ebx ecx edx esi edi

    ; Verificar token[1] = registro
    mov esi, [tokens + 4]
    call parse_reg
    jc .error

    ; Verificar token[2] = ","
    mov esi, [tokens + 8]
    cmp byte [esi], ','
    jne .error

    ; Token[3] = nombre de variable
    mov esi, [tokens + 12]
    cmp byte [esi], '@'
    jne .error
    inc esi

    ; Buscar variable en lab_name
    xor ebx, ebx
    mov edi, lab_name
.buscar_loop:
    cmp ebx, [lab_cnt]
    jae .no_encontrado

    push esi edi
    mov ecx, esi
.cmp_loop:
    mov al, [ecx]
    mov ah, [edi]
    cmp al, ah
    jne .cmp_no
    test al, al
    jz .cmp_si
    inc ecx
    inc edi
    jmp .cmp_loop
.cmp_no:
    pop edi esi
    add edi, LAB_SZ
    inc ebx
    jmp .buscar_loop
.cmp_si:
    pop edi esi

    ; ebx = indice de variable, lab_addr[ebx] = offset en output
    ; Direccion real = out_pos + lab_addr[ebx] + 9 (despues de stub)
    mov eax, [out_pos]
    add eax, [lab_addr + ebx*4]
    add eax, 9             ; saltar el stub del handler

    ; Guardar patch para resolver address
    mov ecx, [patch_cnt]
    cmp ecx, MAX_LABS
    jae patch_err
    mov [patch_ip + ecx*4], eax
    mov [patch_str + ecx*4], ebx   ; reusar patch_str para var index
    inc [patch_cnt]

    ; mov eax, 3 (sys_read)
    mov al, 0xB8
    call emitir_byte
    mov eax, 3
    call emitir_dword

    ; mov ebx, 0 (stdin)
    mov al, 0xBB
    call emitir_byte
    xor eax, eax
    call emitir_dword

    ; mov ecx, <addr placeholder>
    mov al, 0xB9
    call emitir_byte
    mov eax, [lab_addr + ebx*4]   ; placeholder real
    call emitir_dword

    ; mov edx, 255 (max len)
    mov al, 0xBA
    call emitir_byte
    mov eax, 255
    call emitir_dword

    ; int 0x80
    mov al, 0xCD
    call emitir_byte
    mov al, 0x80
    call emitir_byte

    pop edi esi edx ecx ebx eax
    ret

.no_encontrado:
    pop edi esi edx ecx ebx eax
    jmp var_err

.error:
    pop edi esi edx ecx ebx eax
    jmp syn_err

; ---- str_len: longitud de string en esi ----
str_len:
    push esi
    xor eax, eax
.loop:
    lodsb
    test al, al
    jz .fin
    inc eax
    jmp .loop
.fin:
    pop esi
    ret

; ---- instr_escribir: escribir @str (print to stdout) ----
; Syntax: escribir @NOMBRE
; Emite: codigo para calcular addr + strlen + syscall write
instr_escribir:
    push eax ebx ecx esi edi

    ; Verificar token[1] = @nombre
    mov esi, [tokens + 4]
    cmp byte [esi], '@'
    jne .error
    inc esi                 ; saltar @

    ; Buscar string en str_name
    xor ebx, ebx            ; indice = 0
    mov edi, str_name
.buscar_loop:
    cmp ebx, [str_cnt]
    jae .no_encontrado

    ; Comparar nombre
    push esi edi
    mov ecx, esi
.cmp_loop:
    mov al, [ecx]
    mov ah, [edi]
    cmp al, ah
    jne .cmp_no
    test al, al
    jz .cmp_si
    inc ecx
    inc edi
    jmp .cmp_loop
.cmp_no:
    pop edi esi
    add edi, LAB_SZ
    inc ebx
    jmp .buscar_loop
.cmp_si:
    pop edi esi

    ; Encontrado: ebx = indice del string
    ; Guardar parche: patch_ip[patch_cnt] = cur_ip, patch_str[patch_cnt] = ebx
    mov eax, [patch_cnt]
    cmp eax, MAX_LABS
    jae patch_err
    mov ecx, [cur_ip]
    mov [patch_ip + eax*4], ecx
    mov [patch_str + eax*4], ebx
    inc [patch_cnt]

    ; Emitir placeholder: B8 <dword 0> (mov eax, 0 — sera parcheado)
    mov al, 0xB8
    call emitir_byte
    xor eax, eax
    call emitir_dword       ; 5 bytes placeholder

    ; Emitir strlen loop + write syscall
    ; eax = puntero al string (calculado: code_size + str_offset)
    ;eax ya esta en el placeholder, calculamos luego

    ; Calcular addr: eax = cur_ip (despues del placeholder)
    ; emitir: add eax, <str_offset> (05 <dword>)
    mov al, 0x05            ; add eax, imm32
    call emitir_byte
    ; Emitir str_offset como placeholder (se parcheara)
    mov eax, ebx            ; guardar indice
    push ebx
    ; Calcular offset aproximado del string
    ; offset = sumatoria de longitudes anteriores + num_strings_anteriores
    xor ecx, ecx            ; offset acumulado
    xor ebx, ebx            ; indice actual
.calc_offset:
    cmp ebx, eax
    jae .calc_done
    mov edx, [str_len + ebx*4]
    add ecx, edx
    inc ecx                 ; +1 para NUL
    inc ebx
    jmp .calc_offset
.calc_done:
    mov eax, ecx
    pop ebx
    call emitir_dword       ; add eax, <offset>

    ; strlen loop: edi = eax (ptr), ecx = 0 (count)
    ; push eax / mov edi, eax / xor ecx, ecx
    mov al, 0x50            ; push eax
    call emitir_byte
    mov al, 0x89            ; mov edi, eax
    call emitir_byte
    mov al, 0xC7            ; ModRM: mod=11, reg=111(edi), rm=000(eax)
    call emitir_byte

    ; xor ecx, ecx
    mov al, 0x31            ; xor ecx, ecx
    call emitir_byte
    mov al, 0xC9            ; ModRM: mod=11, reg=001(ecx), rm=001(ecx)
    call emitir_byte

    ; .loop: cmp byte [edi+ecx], 0
    mov al, 0x80            ; cmp byte [edi+ecx], imm8
    call emitir_byte
    mov al, 0x3C            ; ModRM: mod=00, reg=111(/7), rm=100(sib)
    call emitir_byte
    mov al, 0x0F            ; SIB: base=edi, index=ecx, scale=1
    call emitir_byte
    xor eax, eax            ; imm8 = 0
    call emitir_byte

    ; je .done (placeholder, 2 bytes)
    mov al, 0x74            ; je rel8
    call emitir_byte
    mov al, 0x02            ; offset = 2 (salta sobre inc+jmp)
    call emitir_byte

    ; inc ecx
    mov al, 0x41            ; inc ecx
    call emitir_byte

    ; jmp .loop (-8 bytes: 1+1+1+1+1+1+1+1 = 8 desde inc hasta cmp)
    mov al, 0xEB            ; jmp rel8
    call emitir_byte
    mov al, 0xF8            ; -8
    call emitir_byte

    ; pop eax (restaurar puntero)
    mov al, 0x58            ; pop eax
    call emitir_byte

    ; edx = ecx (len)
    mov al, 0x89            ; mov edx, ecx
    call emitir_byte
    mov al, 0xCA            ; ModRM: mod=11, reg=010(edx), rm=001(ecx)
    call emitir_byte

    ; ecx = eax (ptr)
    mov al, 0x89            ; mov ecx, eax
    call emitir_byte
    mov al, 0xC1            ; ModRM: mod=11, reg=000(eax), rm=001(ecx) -> ecx = eax
    call emitir_byte

    ; ebx = 1 (stdout)
    mov al, 0xBB            ; mov ebx, 1
    call emitir_byte
    mov eax, 1
    call emitir_dword

    ; eax = 4 (SYS_WRITE)
    mov al, 0xB8            ; mov eax, 4
    call emitir_byte
    mov eax, 4
    call emitir_dword

    ; int 0x80
    mov al, 0xCD            ; int 0x80
    call emitir_byte
    mov al, 0x80
    call emitir_byte

    pop edi esi ecx ebx eax
    ret

.no_encontrado:
    pop edi esi ecx ebx eax
    jmp str_err

.error:
    pop edi esi ecx ebx eax
    jmp syn_err

; ---- parchear_strings: resolver referencias y emitir datos ----
; Llamar despues de pase2, antes de escribir el archivo de salida
parchear_strings:
    push eax ebx ecx edx esi edi

    cmp [patch_cnt], 0
    je .sin_parches

    ; Para cada parche, calcular direccion real del string
    xor ebx, ebx            ; indice de parche
.parche_loop:
    cmp ebx, [patch_cnt]
    jae .fin_parches

    ; Obtener string index
    mov ecx, [patch_str + ebx*4]

    ; Calcular offset del string en str_data
    xor edx, edx            ; offset acumulado
    xor esi, esi            ; indice de string
.calc_offset:
    cmp esi, ecx
    jae .offset_done
    mov eax, [str_len + esi*4]
    add edx, eax
    inc edx                 ; +1 para NUL
    inc esi
    jmp .calc_offset
.offset_done:

    ; Direccion real = out_pos (code_size) + edx (str_offset)
    mov eax, [out_pos]
    add eax, edx

    ; Escribir direccion en out_buf + patch_ip[ebx] + 1 (despues del B8)
    mov edi, out_buf
    add edi, [patch_ip + ebx*4]
    inc edi                 ; saltar opcode B8
    mov [edi], eax

    inc ebx
    jmp .parche_loop

.fin_parches:
    ; Emitir datos de strings al final del codigo
    xor ebx, ebx            ; indice de string
.str_loop:
    cmp ebx, [str_cnt]
    jae .sin_parches

    ; Copiar str_data[offset..offset+len] a out_buf
    mov esi, str_data
    ; Calcular offset
    xor ecx, ecx
    xor edi, edi
.calc_strofs:
    cmp edi, ebx
    jae .copiar_str
    mov eax, [str_len + edi*4]
    add ecx, eax
    inc ecx                 ; +1 NUL
    inc edi
    jmp .calc_strofs
.copiar_str:
    add esi, ecx            ; esi = puntero al string en str_data
    mov ecx, [str_len + ebx*4]
    inc ecx                 ; +1 para NUL
.copiar_loop:
    push ecx
    lodsb
    call emitir_byte
    pop ecx
    loop .copiar_loop

    inc ebx
    jmp .str_loop

.sin_parches:
    pop edi esi edx ecx ebx eax
    ret

; ---- Manejadores de error ----
usage:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_usage
    mov edx, msg_usage_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

open_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_noent
    mov edx, 21
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

read_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_readerr
    mov edx, 21
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

write_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_wrterr
    mov edx, msg_wrterr_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

lab_full:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_labfull
    mov edx, msg_labfull_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

syn_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_synerr
    mov edx, msg_synerr_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

name_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_name_long
    mov edx, msg_name_long_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

tok_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_tok_full
    mov edx, msg_tok_full_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

buf_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_buf_full
    mov edx, msg_buf_full_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

str_full:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_str_full
    mov edx, msg_str_full_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

patch_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_patch_full
    mov edx, msg_patch_full_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

str_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_str_not
    mov edx, msg_str_not_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

var_err:
    mov eax, SYS_WRITE
    mov ebx, STDERR
    mov ecx, msg_var_not
    mov edx, msg_var_not_sz
    int 0x80
    mov eax, SYS_EXIT
    mov ebx, 1
    int 0x80

; ---- parse_reg: convertir nombre de registro a indice ----
; Entrada: esi = puntero al nombre del registro
; Salida: eax = 0..3 (al, cl, dl, bl), CF si error
; Registros soportados: al, cl, dl, bl
parse_reg:
    push esi ecx
    mov ecx, esi

    ; Verificar longitud 2
    cmp byte [ecx+2], 0
    jne .error

    ; Verificar que empiece con 'a', 'c', 'd', 'b'
    mov al, [ecx]
    cmp al, 'a'
    je .reg_a
    cmp al, 'c'
    je .reg_c
    cmp al, 'd'
    je .reg_d
    cmp al, 'b'
    je .reg_b
    jmp .error

.reg_a:
    cmp byte [ecx+1], 'l'
    jne .error
    xor eax, eax          ; 0 = al
    clc
    pop ecx esi
    ret

.reg_c:
    cmp byte [ecx+1], 'l'
    jne .error
    mov eax, 1            ; 1 = cl
    clc
    pop ecx esi
    ret

.reg_d:
    cmp byte [ecx+1], 'l'
    jne .error
    mov eax, 2            ; 2 = dl
    clc
    pop ecx esi
    ret

.reg_b:
    cmp byte [ecx+1], 'l'
    jne .error
    mov eax, 3            ; 3 = bl
    clc
    pop ecx esi
    ret

.error:
    stc
    pop ecx esi
    ret

; ---- reg_enc: codificacion ModRM para registros ----
; Indice: 0=al(cl), 1=cl(dl), 2=dl(bl), 3=bl
reg_enc db 0, 1, 2, 3

; ---- Mensajes de error ----
msg_var_not db "Error: variable no encontrada", 10
msg_var_not_sz = $ - msg_var_not
